# Домен кабинета, A-запись должна указывать на сервер
DOMAIN=check.example.ru

POSTGRES_PASSWORD=поменяйте-меня
DATABASE_URL=postgresql+asyncpg://bg:поменяйте-меня@db:5432/bg
REDIS_URL=redis://redis:6379

# Случайная строка: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
COOKIE_SECURE=1

# Общий секрет для запросов Telegram-бота к API
BOT_API_TOKEN=
# Токен бота от @BotFather
BOT_TOKEN=

# Сколько секунд ждать ввода капчи
CAPTCHA_TIMEOUT=180

# DaData: основной источник карточки компании (ключ из личного кабинета dadata.ru → «API-ключи»).
# Без ключа карточка берётся только с pb.nalog.ru.
DADATA_API_KEY=
# Секрет нужен только методам «Стандартизации», для карточки компании не обязателен.
# DADATA_SECRET=
# pb.nalog.ru: always — дополнять DaData (по умолчанию), fallback — только при сбое DaData, off — выключить
# PBNALOG_MODE=always

# Токен сервиса отдачи документов ЕИС для подбора закупок (zakupki.gov.ru/pmd/auth/welcome)
EIS_TOKEN=
# Необязательно: свои виды документов ЕИС по законам, см. README
# EIS_DOC_TYPES=615-ПП=PRIZ:pprf615NotificationEF
# Необязательно: подбор закупок по смыслу (pip install -r requirements-ml.txt)
# EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBED_THRESHOLD=0.6
# Реестр ст. 19.28 КоАП (файл ЕИС), см. README. Все три необязательны.
KOAP1928_CACHE=/srv/data/koap1928.xlsx   # куда сохранять последнюю скачанную копию
# KOAP1928_URL=                            # прямая ссылка на файл, если страница ЕИС поменялась
# KOAP1928_FILE=                           # локальный .xlsx, скачанный вручную (сайт не опрашивается)
# Открытые данные ФНС (дисквалифицированные лица, налоговые правонарушения): куда скачивать.
FNS_OPENDATA_DIR=/srv/data/fns-opendata
# Блокировки счетов (см. README). Оба необязательны.
# FNS_BI_BIK=044525225          # БИК в запросе к service.nalog.ru/bi.do
# CBR_ZSK_URL=                  # адрес запроса формы ЦБ «Проверка по ИНН», если найден на сервере
